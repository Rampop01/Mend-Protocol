# Copy to .env. Every value is optional: Mend reports what is disabled at startup.

# --- Server -----------------------------------------------------------------
MEND_HOST=127.0.0.1
PORT=8770
# Required when MEND_HOST is not loopback. The SDK sends it as a bearer token.
MEND_INGEST_TOKEN=

# --- Telegram (mobile review and approval) ------------------------------------
TELEGRAM_BOT_TOKEN=
# Send /start to your bot to see these ids.
TELEGRAM_CHAT_ID=
# Comma-separated Telegram user ids allowed to approve. Empty: anyone in the chat.
TELEGRAM_APPROVER_IDS=

# --- LLM forge agent (NEAR AI Cloud, https://cloud.near.ai) --------------------
NEAR_AI_API_KEY=
MEND_LLM_MODEL=anthropic/claude-sonnet-5-5

# --- GitHub (opens a pull request for each approved fix) ----------------------
GITHUB_TOKEN=

# --- NEAR ---------------------------------------------------------------------
# Accounts and keys are created by `python -m mend setup` and stored in .mend/testnet.json.
NEAR_NETWORK=testnet
MEND_BOUNTY_NEAR=0.25

# --- Public service (anyone can use the Telegram bot) -------------------------
# MEND_PUBLIC=1 requires MEND_SECRET_KEY, GITHUB_CLIENT_ID and MEND_INGEST_TOKEN.
MEND_PUBLIC=0
MEND_PUBLIC_URL=
# 32 random bytes, base64: python -c "from mend.accounts import Vault; print(Vault.new_key())"
MEND_SECRET_KEY=
# Client ID of a GitHub OAuth App with "Enable Device Flow" ticked.
GITHUB_CLIENT_ID=
# docker: run every test suite in a locked-down container (build deploy/sandbox.Dockerfile first).
MEND_SANDBOX=local
MEND_TREASURY_DEPOSIT_NEAR=2
MEND_MAX_BOUNTY_NEAR=0.5
